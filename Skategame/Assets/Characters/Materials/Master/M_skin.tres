code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D skin_light : source_color;
uniform sampler2D skin_dark : source_color;
uniform float skin_color = 0.0;
uniform vec4 underwear_color : source_color = vec4(0.000000, 0.000000, 1.000000, 1.000000);
uniform sampler2D mask;
uniform sampler2D decal : source_color, hint_default_transparent, repeat_disable;
uniform sampler2D orm;
uniform vec4 eyes_color : source_color = vec4(0.000000, 0.000000, 1.000000, 1.000000);
uniform float Roughness_Power = 1.0;
uniform vec4 backlight : source_color = vec4(0.000000, 0.000000, 0.000000, 1.000000);
uniform sampler2D normal : hint_normal;
uniform float Normal_Depth = 0.10000000149012;
uniform float Rim = 0.10000000149012;
uniform float Rim_Tint = 0.5;



void fragment() {
	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(skin_light, UV);


	vec4 n_out32p0;
// Texture2D:32
	n_out32p0 = texture(skin_dark, UV);


// FloatParameter:34
	float n_out34p0 = skin_color;


// Mix:33
	vec3 n_out33p0 = mix(vec3(n_out3p0.xyz), vec3(n_out32p0.xyz), vec3(n_out34p0));


// VectorOp:50
	vec3 n_in50p1 = vec3(0.25000, 0.25000, 0.25000);
	vec3 n_out50p0 = pow(n_out33p0, n_in50p1);


// ColorParameter:41
	vec4 n_out41p0 = underwear_color;


// VectorOp:49
	vec3 n_out49p0 = n_out50p0 * vec3(n_out41p0.xyz);


	vec4 n_out39p0;
// Texture2D:39
	n_out39p0 = texture(mask, UV);


// VectorDecompose:40
	float n_out40p0 = vec3(n_out39p0.xyz).x;
	float n_out40p1 = vec3(n_out39p0.xyz).y;
	float n_out40p2 = vec3(n_out39p0.xyz).z;


// Mix:42
	vec3 n_out42p0 = mix(n_out33p0, n_out49p0, vec3(n_out40p2));


// Input:26
	vec2 n_out26p0 = UV2;


	vec4 n_out27p0;
// Texture2D:27
	n_out27p0 = texture(decal, n_out26p0);
	float n_out27p4 = n_out27p0.a;


// Mix:43
	vec3 n_out43p0 = mix(n_out42p0, vec3(n_out27p0.xyz), vec3(n_out27p4));


	vec4 n_out2p0;
// Texture2D:2
	n_out2p0 = texture(orm, UV);


// VectorDecompose:18
	float n_out18p0 = vec3(n_out2p0.xyz).x;
	float n_out18p1 = vec3(n_out2p0.xyz).y;
	float n_out18p2 = vec3(n_out2p0.xyz).z;


// VectorOp:44
	vec3 n_out44p0 = n_out43p0 * vec3(n_out18p0);


	vec3 n_out45p0;
// ColorOp:45
	{
		float base = n_out44p0.x;
		float blend = vec3(n_out40p0).x;
		if (base < 0.5) {
			n_out45p0.x = 2.0 * base * blend;
		} else {
			n_out45p0.x = 1.0 - 2.0 * (1.0 - blend) * (1.0 - base);
		}
	}
	{
		float base = n_out44p0.y;
		float blend = vec3(n_out40p0).y;
		if (base < 0.5) {
			n_out45p0.y = 2.0 * base * blend;
		} else {
			n_out45p0.y = 1.0 - 2.0 * (1.0 - blend) * (1.0 - base);
		}
	}
	{
		float base = n_out44p0.z;
		float blend = vec3(n_out40p0).z;
		if (base < 0.5) {
			n_out45p0.z = 2.0 * base * blend;
		} else {
			n_out45p0.z = 1.0 - 2.0 * (1.0 - blend) * (1.0 - base);
		}
	}


// ColorParameter:7
	vec4 n_out7p0 = eyes_color;


// VectorOp:48
	vec3 n_out48p0 = n_out45p0 * vec3(n_out7p0.xyz);


// Mix:46
	vec3 n_out46p0 = mix(n_out45p0, n_out48p0, vec3(n_out40p1));


// Reroute:23
	float n_out23p0 = n_out18p2;


// Reroute:22
	float n_out22p0 = n_out18p1;


// FloatParameter:29
	float n_out29p0 = Roughness_Power;


// FloatOp:30
	float n_out30p0 = pow(n_out22p0, n_out29p0);


// ColorParameter:37
	vec4 n_out37p0 = backlight;


// VectorOp:51
	vec3 n_out51p0 = n_out46p0 * vec3(n_out37p0.xyz);


// Reroute:21
	float n_out21p0 = n_out18p0;


	vec4 n_out14p0;
// Texture2D:14
	n_out14p0 = texture(normal, UV);


// Reroute:25
	vec4 n_out25p0 = n_out14p0;


// FloatParameter:47
	float n_out47p0 = Normal_Depth;


// FloatParameter:19
	float n_out19p0 = Rim;


// FloatParameter:28
	float n_out28p0 = Rim_Tint;


// Output:0
	ALBEDO = n_out46p0;
	METALLIC = n_out23p0;
	ROUGHNESS = n_out30p0;
	EMISSION = n_out51p0;
	AO = n_out21p0;
	NORMAL_MAP = vec3(n_out25p0.xyz);
	NORMAL_MAP_DEPTH = n_out47p0;
	RIM = n_out19p0;
	RIM_TINT = n_out28p0;


}
