code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D tex_frg_30 : source_color;
uniform sampler2D decal : source_color, hint_default_transparent, repeat_disable;
uniform sampler2D mask;
uniform vec4 accent_colormix : source_color = vec4(0.000000, 1.000000, 0.250980, 1.000000);
uniform vec4 wheels_color : source_color = vec4(0.000000, 0.000000, 1.000000, 1.000000);
uniform vec4 metal_color : source_color = vec4(0.000000, 0.000000, 1.000000, 1.000000);
uniform sampler2D orm;
uniform float Roughness_Power = 1.0;
uniform vec4 backlight : source_color = vec4(0.100888, 0.093325, 0.055666, 1.000000);
uniform sampler2D normal : hint_normal;
uniform float Normal_Depth = 0.5;
uniform float Rim = 0.10000000149012;
uniform float Rim_Tint = 0.5;



void fragment() {
// Texture2D:30
	vec4 n_out30p0 = texture(tex_frg_30, UV);


// Input:26
	vec2 n_out26p0 = UV2;


	vec4 n_out27p0;
// Texture2D:27
	n_out27p0 = texture(decal, n_out26p0);
	float n_out27p4 = n_out27p0.a;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(mask, UV);


// VectorDecompose:5
	float n_out5p0 = vec3(n_out3p0.xyz).x;
	float n_out5p1 = vec3(n_out3p0.xyz).y;
	float n_out5p2 = vec3(n_out3p0.xyz).z;


// FloatOp:38
	float n_out38p0 = n_out27p4 * n_out5p2;


// Mix:40
	vec3 n_out40p0 = mix(vec3(n_out30p0.xyz), vec3(n_out27p0.xyz), vec3(n_out38p0));


// ColorParameter:6
	vec4 n_out6p0 = accent_colormix;


// Mix:41
	vec3 n_out41p0 = mix(n_out40p0, vec3(n_out6p0.xyz), vec3(n_out5p0));


// ColorParameter:7
	vec4 n_out7p0 = wheels_color;


// Mix:42
	vec3 n_out42p0 = mix(n_out41p0, vec3(n_out7p0.xyz), vec3(n_out5p1));


// ColorParameter:32
	vec4 n_out32p0 = metal_color;


	vec4 n_out2p0;
// Texture2D:2
	n_out2p0 = texture(orm, UV);


// VectorDecompose:18
	float n_out18p0 = vec3(n_out2p0.xyz).x;
	float n_out18p1 = vec3(n_out2p0.xyz).y;
	float n_out18p2 = vec3(n_out2p0.xyz).z;


// Mix:43
	vec3 n_out43p0 = mix(n_out42p0, vec3(n_out32p0.xyz), vec3(n_out18p2));


// Reroute:45
	float n_out45p0 = n_out18p0;


// VectorOp:44
	vec3 n_out44p0 = n_out43p0 * vec3(n_out45p0);


// Reroute:24
	vec3 n_out24p0 = n_out44p0;


// Reroute:23
	float n_out23p0 = n_out18p2;


// Reroute:22
	float n_out22p0 = n_out18p1;


// FloatParameter:34
	float n_out34p0 = Roughness_Power;


// FloatOp:33
	float n_out33p0 = pow(n_out22p0, n_out34p0);


// ColorParameter:46
	vec4 n_out46p0 = backlight;


// VectorOp:47
	vec3 n_out47p0 = n_out44p0 * vec3(n_out46p0.xyz);


// Reroute:21
	float n_out21p0 = n_out18p0;


	vec4 n_out14p0;
// Texture2D:14
	n_out14p0 = texture(normal, UV);


// Reroute:25
	vec4 n_out25p0 = n_out14p0;


// FloatParameter:39
	float n_out39p0 = Normal_Depth;


// FloatParameter:19
	float n_out19p0 = Rim;


// FloatParameter:28
	float n_out28p0 = Rim_Tint;


// Output:0
	ALBEDO = n_out24p0;
	METALLIC = n_out23p0;
	ROUGHNESS = n_out33p0;
	EMISSION = n_out47p0;
	AO = n_out21p0;
	NORMAL_MAP = vec3(n_out25p0.xyz);
	NORMAL_MAP_DEPTH = n_out39p0;
	RIM = n_out19p0;
	RIM_TINT = n_out28p0;


}
