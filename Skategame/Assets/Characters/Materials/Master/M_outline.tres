render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform float normalOffset = 0.0;
uniform vec4 outline_color : source_color = vec4(0.056799, 0.118929, 0.231158, 1.000000);



