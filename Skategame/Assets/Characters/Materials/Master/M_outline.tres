code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform float normalOffset = 0.0;
uniform vec4 outline_color : source_color = vec4(0.080400, 0.094260, 0.120000, 1.000000);



void vertex() {
// Input:3
	vec3 n_out3p0 = VERTEX;


// Input:2
	vec3 n_out2p0 = NORMAL;


// FloatParameter:6
	float n_out6p0 = normalOffset;


// FloatOp:7
	float n_in7p1 = -1.00000;
	float n_out7p0 = n_out6p0 * n_in7p1;


// VectorOp:5
	vec3 n_out5p0 = n_out2p0 * vec3(n_out7p0);


// VectorOp:4
	vec3 n_out4p0 = n_out3p0 + n_out5p0;


// Output:0
	VERTEX = n_out4p0;


}

void fragment() {
// ColorConstant:5
	vec4 n_out5p0 = vec4(0.000000, 0.000000, 0.000000, 1.000000);


// ColorParameter:4
	vec4 n_out4p0 = outline_color;


// Output:0
	ALBEDO = vec3(n_out5p0.xyz);
	EMISSION = vec3(n_out4p0.xyz);


}
